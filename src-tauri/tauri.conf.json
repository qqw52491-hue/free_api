{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Free API Chat",
  "version": "0.1.0",
  "identifier": "com.free-api-chat.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Free API Chat",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "prompts/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2OUQ2QUQ0NEVGOUNBREUKUldUZXl2bE8xR3FkaHRpTlhQdXh0eE0xbVVxckFtL2FNSHN6T1J4LzJTL2tBaEtLTTFidDByWVQK",
      "endpoints": [
        "https://github.com/qqw52491-hue/free_api/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}
