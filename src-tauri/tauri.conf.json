{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Free API Chat",
  "version": "0.1.0",
  "identifier": "com.free-api-chat.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Free API Chat",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "prompts/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFQUM1RkMxNTMzNjY0RDEKUldUUlpEWlR3VitzN3BTK2xMcjJaNldsM1VHK01IUHkxUUtFT0ZSRUp2ajRIZDJWQVBvMXJiWmkK",
      "endpoints": [
        "https://agent.wxhjy.dpdns.org/update/latest.json",
        "http://localhost:8790/update/latest.json"
      ],
      "dialog": false
    }
  }
}