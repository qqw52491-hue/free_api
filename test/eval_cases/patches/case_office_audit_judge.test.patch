+#!/usr/bin/env python3
+"""判据：办公场景——订单数据审计（开放诊断）。
+输入: test/eval_cases/fixtures/office_audit/input/orders.csv（31 行含 6 类异常：
+      负金额/负数量/未来日期/重复订单号/空客户名/非数字金额）。
+要求: output/audit_report.md 分类列出发现的异常（类型+订单号或行号）。
+判据（全部满足）:
+ 1. output/audit_report.md 存在；
+ 2. 至少覆盖 4 种异常类型（关键词：负/负数、未来/日期、重复/duplicate、空/缺失、非数字/格式）；
+ 3. 至少提及 3 个具体异常订单号（O-20xx）；
+ 4. 不得把正常行 O-2000~O-2024 中的 ≥5 个错报为异常（错报容忍度检查——
+    报告提及的正常号段订单数 <5，豁免说明性提及）。
+"""
+import sys, os, re
+
+fails = []
+rpt = 'output/audit_report.md'
+if not os.path.exists(rpt):
+    cands = [os.path.join('output', f) for f in os.listdir('output') if f.endswith('.md')] if os.path.isdir('output') else []
+    if cands: rpt = cands[0]
+    else: fails.append('output/audit_report.md 不存在'); print('JUDGE FAIL'); sys.exit(1)
+
+body = open(rpt, encoding='utf-8').read()
+
+cats = {
+    '负值': r'负|-150|-3',
+    '未来日期': r'未来|2025-12|超期|日期.*异常|future',
+    '重复': r'重复|duplicate|重号',
+    '空值/缺失': r'空|缺失|missing|empty|空白',
+    '格式/非数字': r'非数字|格式|N/A|无效|invalid|类型',
+}
+hit = sum(1 for p in cats.values() if re.search(p, body, re.I))
+if hit < 4:
+    fails.append(f'异常类型覆盖 {hit}/6（<4）')
+
+ids = set(re.findall(r'O-20\d\d', body))
+real_anoms = {'O-2026','O-2027','O-2028','O-2005','O-2030','O-2031'}
+found = ids & real_anoms
+if len(found) < 3:
+    fails.append(f'具体异常订单号仅命中 {len(found)} 个（<3）：{sorted(found)}')
+
+# 错报检查：正常单被点名数
+normals = {f'O-20{i:02d}' for i in range(0,25)} - real_anoms
+false_named = ids & normals
+if len(false_named) >= 5:
+    fails.append(f'误报正常订单 {len(false_named)} 个：{sorted(false_named)[:6]}')
+
+if fails:
+    for f in fails: print('❌', f)
+    print('JUDGE FAIL'); sys.exit(1)
+print('✅ JUDGE PASS')
