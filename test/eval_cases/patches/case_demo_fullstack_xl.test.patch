diff --git a/test/eval_cases/fixtures/fullstack_xl/judge.mjs b/test/eval_cases/fixtures/fullstack_xl/judge.mjs
new file mode 100644
index 0000000..2688046
--- /dev/null
+++ b/test/eval_cases/fixtures/fullstack_xl/judge.mjs
@@ -0,0 +1,54 @@
+// 判据：书签管理器——CRUD+tag过滤+stats+持久化+前端/CLI/文档存在
+import { spawn } from 'node:child_process';
+import fs from 'node:fs';
+
+const fails = [];
+const need = ['demo_app/backend/server.js','demo_app/backend/store.js','demo_app/frontend/index.html','demo_app/frontend/app.js','demo_app/cli.js','demo_app/README.md'];
+for (const p of need) if (!fs.existsSync(p)) fails.push(`${p} 缺失`);
+const frontSrc = ['demo_app/frontend/app.js','demo_app/frontend/api.js','demo_app/frontend/views.js'].map(p=>fs.existsSync(p)?fs.readFileSync(p,'utf8'):'').join('\n');
+if (!/bookmarks/.test(frontSrc) || !/fetch|XMLHttpRequest/.test(frontSrc)) fails.push('前端未见对 bookmarks 接口的请求');
+
+const B='http://127.0.0.1:8787';
+async function start() {
+  const srv = spawn('node',['demo_app/backend/server.js'],{stdio:'pipe'});
+  srv.stderr.on('data',()=>{}); srv.stdout.on('data',()=>{});
+  await new Promise(r=>setTimeout(r,1500));
+  return srv;
+}
+if (fs.existsSync('demo_app/backend/server.js')) {
+  let srv = await start();
+  let newId;
+  try {
+    let res = await fetch(B+'/api/bookmarks');
+    let list = await res.json();
+    if (!Array.isArray(list)) fails.push('GET /api/bookmarks 未返回数组');
+    res = await fetch(B+'/api/bookmarks',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({url:'https://judge.example.com',title:'judge_bm',tags:['testtag']})});
+    if (res.status!==200&&res.status!==201) fails.push(`POST /api/bookmarks HTTP ${res.status}`);
+    else { const c=await res.json(); newId=c.id; if(newId===undefined)fails.push('POST 响应缺 id'); }
+    res = await fetch(B+'/api/bookmarks',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({title:'no url'})});
+    if (res.status!==400) fails.push(`POST 缺 url 未 400（实得 ${res.status}）`);
+    res = await fetch(B+'/api/bookmarks?tag=testtag');
+    const tagged = await res.json();
+    if (!Array.isArray(tagged)||!tagged.some(b=>b.title==='judge_bm')) fails.push('?tag= 过滤未生效');
+    res = await fetch(B+'/api/bookmarks?q=judge_bm');
+    const searched = await res.json();
+    if (!Array.isArray(searched)||!searched.some(b=>b.title==='judge_bm')) fails.push('?q= 搜索未生效');
+    res = await fetch(B+'/api/stats');
+    const stats = await res.json();
+    if (typeof stats.total!=='number' || stats.total<1) fails.push('/api/stats 缺 total 或为 0');
+    if (newId!==undefined) {
+      res = await fetch(`${B}/api/bookmarks/${newId}`,{method:'DELETE'});
+      if (!res.ok) fails.push(`DELETE HTTP ${res.status}`);
+    }
+  } catch(e){ fails.push('服务不可达: '+e.message); }
+  srv.kill(); await new Promise(r=>setTimeout(r,500));
+  srv = await start();
+  try {
+    const res = await fetch(B+'/api/bookmarks');
+    const list = await res.json();
+    if (!Array.isArray(list)) fails.push('重启后服务异常');
+  } catch(e){ fails.push('重启后服务不可达'); }
+  srv.kill();
+}
+if (fails.length) { console.log('JUDGE FAIL:', fails.join(' | ')); process.exit(1); }
+console.log('JUDGE PASS');
