{
  "name": "tauri-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:nowatch": "tauri dev --no-watch",
    "clean:rust": "cd src-tauri && cargo clean",
    "dev:wayland": "WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri dev",
    "dev:wayland:nowatch": "WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri dev --no-watch",
    "dev:x11": "GDK_BACKEND=x11 WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri dev",
    "dev:x11:nowatch": "GDK_BACKEND=x11 WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri dev --no-watch",
    "test:e2e:build": "CARGO_TARGET_DIR=target-eval tauri build --debug --features wdio --no-bundle --config src-tauri/tauri.test.conf.json",
    "test:e2e": "npm run test:e2e:build && wdio run wdio.conf.mjs",
    "eval:real": "node scripts/eval_runner.mjs",
    "eval:real:dry": "node scripts/eval_runner.mjs --dry-run",
    "sync:types": "cd src-tauri && cargo test -- export_bindings && mkdir -p ../src/types/generated && cp src/types/generated/*.ts ../src/types/generated/"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.0",
    "@vueuse/core": "^14.2.1",
    "dompurify": "^3.4.13",
    "echarts": "^6.1.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.4",
    "marked": "^17.0.6",
    "mermaid": "^11.16.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/katex": "^0.16.8",
    "@vitejs/plugin-vue": "^5.2.1",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/tauri-service": "^1.3.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
